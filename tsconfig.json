{
  "compilerOptions": {
    "allowUnreachableCode": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "target": "es2022",
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "types": ["./types/bin-links.d.ts"]
  },
  "include": ["./src"],
  "exclude": ["**/node_modules/**"]
}
